import socket

HOST = "127.0.0.1"
PORT = 5005

client = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

filename = input("Enter filename: ")

client.sendto(filename.encode(), (HOST, PORT))

data, addr = client.recvfrom(4096)

print("File Content:")
print(data.decode())

client.close()
