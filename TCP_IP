import socket

HOST = '127.0.0.1'
PORT = 65432

filename = input("Enter file name: ")

client = socket.socket()
client.connect((HOST, PORT))

client.send(filename.encode())

data = client.recv(4096).decode()

print("File Content:")
print(data)

client.close()

